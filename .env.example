# ── LLM configuration (optional — app works fully without it) ─────────────────
#
# LLM_MODEL selects the provider+model. Examples:
#
#   Anthropic (Claude)
#   LLM_MODEL=claude-sonnet-4-20250514
#   ANTHROPIC_API_KEY=sk-ant-...
#
#   OpenAI
#   LLM_MODEL=gpt-4o
#   OPENAI_API_KEY=sk-...
#
#   Groq (fast, free tier available)
#   LLM_MODEL=groq/llama-3.3-70b-versatile
#   GROQ_API_KEY=gsk_...
#
#   Gemini
#   LLM_MODEL=gemini/gemini-2.0-flash
#   GEMINI_API_KEY=AIza...
#
#   Local Ollama (no key needed)
#   LLM_MODEL=ollama/llama3.2
#   LLM_BASE_URL=http://localhost:11434   # optional, Ollama default
#
# Without any of the above, /api/explain returns pre-generated notes.

# LLM_MODEL=groq/llama-3.3-70b-versatile
# GROQ_API_KEY=

# LLM_BASE_URL=   # custom endpoint, e.g. for Ollama or LM Studio

# ── Frontend deployment (Vercel + separate backend) ───────────────────────────
# Leave unset for local dev or Docker (proxy handles /api routing).
# VITE_API_URL=https://fpc-trace.onrender.com
